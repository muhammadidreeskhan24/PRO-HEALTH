<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-e7f64e37-a2e2-4831-9704-47a4ed09c55d@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pro Health — Routine &amp; Health</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">

</head>
<body>
<div class="wrap">

  <div class="hero">
    <div class="hero-top">
      <div class="brand">Pro Health</div>
      <div class="date" id="dateLabel">Friday, September 4</div>
    </div>
    <div class="clock" id="clock">12:31:51</div>
    <div class="next-line" id="nextLine">Next: <b>Read 20 MCQs</b> in 29m</div>
    <div class="hero-actions">
      <button id="enableBtn">Enable alerts</button>
      <button class="secondary" id="testBtn">Test alert</button>
    </div>
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="routine">Routine</div>
    <div class="tab" data-tab="study">Study &amp; sleep</div>
    <div class="tab" data-tab="health">Weight &amp; height</div>
    <div class="tab" data-tab="walk">Walking</div>
    <div class="tab" data-tab="cal">Calories</div>
  </div>

  <!-- ROUTINE -->
  <div class="panel active" id="panel-routine">
    <h2>Daily routine</h2>
    <p class="sub">Add each part of your day once — it repeats every day and you'll get an alert at that time while this page is open.</p>
    <div class="card">
      <div class="row">
        <div class="field">
          <label>Time</label>
          <input type="time" id="rTime" value="07:00">
        </div>
        <div class="field" style="flex:2;">
          <label>What happens</label>
          <input type="text" id="rLabel" placeholder="e.g. Morning walk">
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button id="rAdd">Add to routine</button>
      </div>
    </div>
    <ul class="timeline" id="routineList"><li class="empty">No routine items yet — add your first one above.</li></ul>
  </div>

  <!-- STUDY & SLEEP -->
  <div class="panel" id="panel-study">
    <h2>Study reminders</h2>
    <p class="sub">A repeating alert to read 20 MCQs, spaced through your waking hours.</p>
    <div class="card">
      <div class="toggle-row">
        <div>
          <div class="t-label">Every-2-hours MCQ reminder</div>
          <div class="t-desc" id="studyDesc">5:00 AM – 11:00 PM, every 2h</div>
        </div>
        <button class="switch on" id="studyToggle"></button>
      </div>
      <div class="row" style="margin-top:12px;">
        <div class="field">
          <label>Start</label>
          <input type="time" id="studyStart" value="05:00">
        </div>
        <div class="field">
          <label>End</label>
          <input type="time" id="studyEnd" value="23:00">
        </div>
        <div class="field">
          <label>Every (hrs)</label>
          <input type="number" id="studyInterval" min="1" max="12" value="2">
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button class="secondary" id="studySave">Save schedule</button>
      </div>
      <p class="note" style="margin-top:10px;" id="studyPreview">Alerts at: 5:00 AM, 7:00 AM, 9:00 AM, 11:00 AM, 1:00 PM, 3:00 PM, 5:00 PM, 7:00 PM, 9:00 PM, 11:00 PM</p>
    </div>

    <h2 style="margin-top:26px;">Sleep</h2>
    <p class="sub">Your sleep window is 11:30 PM – 5:00 AM. A bedtime alert fires beforehand so you're not still on your phone.</p>
    <div class="card">
      <div class="toggle-row">
        <div>
          <div class="t-label">Bedtime alert</div>
          <div class="t-desc" id="bedDesc">11:30 PM — time to go to bed</div>
        </div>
        <button class="switch on" id="bedToggle"></button>
      </div>
      <div class="row" style="margin-top:12px;">
        <div class="field">
          <label>Bedtime</label>
          <input type="time" id="bedTime" value="23:30">
        </div>
        <div class="field">
          <label>Wake time</label>
          <input type="time" id="wakeTime" value="05:00">
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button class="secondary" id="bedSave">Save sleep window</button>
      </div>
    </div>
  </div>

  <!-- HEALTH -->
  <div class="panel" id="panel-health">
    <h2>Weight &amp; height</h2>
    <p class="sub">Log an entry any time. BMI is calculated from your most recent weight and height.</p>
    <div class="stat-row">
      <div class="stat"><div class="num" id="bmiNum">—</div><div class="lbl">BMI</div></div>
      <div class="stat"><div class="num" id="wNum">—</div><div class="lbl">Weight (kg)</div></div>
      <div class="stat"><div class="num" id="hNum">—</div><div class="lbl">Height (cm)</div></div>
    </div>
    <div class="card">
      <div class="row">
        <div class="field">
          <label>Weight (kg)</label>
          <input type="number" step="0.1" id="wIn" placeholder="e.g. 68.5">
        </div>
        <div class="field">
          <label>Height (cm)</label>
          <input type="number" step="0.1" id="hIn" placeholder="e.g. 172">
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button id="wAdd">Log entry</button>
      </div>
    </div>
    <ul class="log-list" id="healthList"><li class="empty">No entries yet.</li></ul>
  </div>

  <!-- WALKING -->
  <div class="panel" id="panel-walk">
    <h2>Walking distance</h2>
    <p class="sub">Track how far you walk each day.</p>
    <div class="stat-row">
      <div class="stat"><div class="num" id="walkToday">0.0</div><div class="lbl">Today (km)</div></div>
      <div class="stat"><div class="num" id="walkWeek">0.0</div><div class="lbl">This week (km)</div></div>
    </div>
    <div class="card">
      <div class="row">
        <div class="field">
          <label>Distance (km)</label>
          <input type="number" step="0.1" id="distIn" placeholder="e.g. 3.2">
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button id="distAdd">Log walk</button>
      </div>
    </div>
    <ul class="log-list" id="walkList"><li class="empty">No walks logged yet.</li></ul>
  </div>

  <!-- CALORIES -->
  <div class="panel" id="panel-cal">
    <h2>Calories</h2>
    <p class="sub">Log what you eat and keep a running total for today.</p>
    <div class="stat-row">
      <div class="stat"><div class="num" id="calToday">0</div><div class="lbl">Today (kcal)</div></div>
    </div>
    <div class="card">
      <div class="row">
        <div class="field" style="flex:2;">
          <label>Item</label>
          <input type="text" id="calItem" placeholder="e.g. Chicken rice bowl">
        </div>
        <div class="field">
          <label>Calories</label>
          <input type="number" id="calAmt" placeholder="e.g. 550">
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button id="calAdd">Log food</button>
      </div>
    </div>
    <ul class="log-list" id="calList"><li class="empty">No food logged yet.</li></ul>
  </div>

  <div class="footnote">
    Alerts (sound, on-screen banner, and browser notification) only fire while this page is open in your browser — it can't wake your phone the way a native alarm does. For a guaranteed wake-up or bedtime alarm, pair this with your phone's built-in alarm; use this for the every-2-hours study nudge and tracking while you're active during the day.
  </div>
</div>

<div id="toast">
  <button class="tx" id="toastClose">✕</button>
  <div class="tt" id="toastTitle">Reminder</div>
  <div class="td" id="toastDesc"></div>
</div>




</body></html>
