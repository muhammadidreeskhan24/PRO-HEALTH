@charset "utf-8";

:root { --paper: #F1EDE2; --paper-raised: #F8F5EC; --ink: #1E2A3A; --ink-soft: #5B6472; --accent: #C0842B; --accent-soft: #EADFC3; --line: #D8D0BC; --danger: #AD4B3C; --danger-soft: #F3DDD6; --success: #4C7A5E; --success-soft: #DCE7DE; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--paper); color: var(--ink); font-family: Inter, sans-serif; -webkit-font-smoothing: antialiased; }

.wrap { max-width: 640px; margin: 0px auto; padding: 28px 20px 80px; }

.hero { border-bottom: 1px solid var(--line); padding-bottom: 22px; margin-bottom: 22px; }

.hero-top { display: flex; justify-content: space-between; align-items: baseline; }

.brand { font-family: Fraunces, serif; font-size: 20px; font-weight: 600; letter-spacing: 0.2px; }

.date { font-size: 12px; color: var(--ink-soft); }

.clock { font-family: Fraunces, serif; font-size: 64px; font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.05; margin: 14px 0px 4px; }

.next-line { font-size: 14px; color: var(--ink-soft); }

.next-line b { color: var(--ink); font-weight: 600; }

.hero-actions { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }

button { font-family: Inter, sans-serif; font-size: 13px; font-weight: 600; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); padding: 9px 14px; border-radius: 3px; cursor: pointer; }

button.secondary { background: transparent; color: var(--ink); border: 1px solid var(--line); }

button.danger { background: transparent; color: var(--danger); border: 1px solid var(--danger-soft); }

button:active { transform: translateY(1px); }

button:disabled { opacity: 0.5; cursor: default; }

.tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin-bottom: 22px; overflow-x: auto; }

.tab { padding: 10px 4px; margin-right: 20px; font-size: 13px; font-weight: 600; color: var(--ink-soft); cursor: pointer; border-bottom: 2px solid transparent; white-space: nowrap; }

.tab.active { color: var(--ink); border-bottom-color: var(--accent); }

.panel { display: none; }

.panel.active { display: block; animation: 0.18s ease 0s 1 normal none running fade; }

@keyframes fade { 
  0% { opacity: 0; transform: translateY(2px); }
  100% { opacity: 1; transform: none; }
}

h2 { font-family: Fraunces, serif; font-size: 19px; font-weight: 600; margin: 0px 0px 4px; }

.sub { font-size: 13px; color: var(--ink-soft); margin: 0px 0px 18px; }

.card { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 4px; padding: 16px; margin-bottom: 14px; }

.row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

.field { display: flex; flex-direction: column; gap: 4px; flex: 1 1 0%; min-width: 110px; }

label { font-size: 11px; color: var(--ink-soft); font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; }

input, select { font-family: Inter, sans-serif; font-size: 14px; padding: 9px 10px; border: 1px solid var(--line); border-radius: 3px; background: rgb(255, 255, 255); color: var(--ink); }

input:focus, select:focus, button:focus { outline: 2px solid var(--accent); outline-offset: 1px; }

.timeline { list-style: none; margin: 0px; padding: 0px; }

.timeline li { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0px; border-bottom: 1px solid var(--line); }

.timeline li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.tl-time { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 13px; min-width: 56px; color: var(--accent); }

.tl-label { flex: 1 1 0%; font-size: 14px; }

.tl-del { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: var(--ink-soft); font-size: 13px; padding: 2px 6px; cursor: pointer; }

.tl-del:hover { color: var(--danger); }

.empty { font-size: 13px; color: var(--ink-soft); padding: 10px 0px; }

.log-list { list-style: none; margin: 0px; padding: 0px; }

.log-list li { display: flex; justify-content: space-between; padding: 9px 0px; border-bottom: 1px solid var(--line); font-size: 13px; }

.log-list li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.log-list .meta { color: var(--ink-soft); }

.stat-row { display: flex; gap: 10px; margin-bottom: 14px; }

.stat { flex: 1 1 0%; background: var(--paper-raised); border: 1px solid var(--line); border-radius: 4px; padding: 12px 14px; }

.stat .num { font-family: Fraunces, serif; font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; }

.stat .lbl { font-size: 11px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.4px; margin-top: 2px; }

.toggle-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0px; border-bottom: 1px solid var(--line); }

.toggle-row:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.toggle-row .t-label { font-size: 14px; font-weight: 600; }

.toggle-row .t-desc { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }

.switch { width: 40px; height: 22px; border-radius: 11px; background: var(--line); position: relative; cursor: pointer; flex-shrink: 0; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

.switch.on { background: var(--success); }

.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 50%; background: rgb(255, 255, 255); transition: left 0.15s; }

.switch.on::after { left: 20px; }

#toast { position: fixed; left: 16px; right: 16px; bottom: 16px; max-width: 608px; margin: 0px auto; background: var(--ink); color: var(--paper); border-radius: 5px; padding: 16px 18px; display: none; box-shadow: rgba(0, 0, 0, 0.25) 0px 8px 24px; z-index: 50; }

#toast.show { display: block; animation: 0.2s ease 0s 1 normal none running rise; }

@keyframes rise { 
  0% { transform: translateY(8px); opacity: 0; }
  100% { transform: none; opacity: 1; }
}

#toast .tt { font-family: Fraunces, serif; font-size: 16px; font-weight: 600; margin-bottom: 2px; }

#toast .td { font-size: 13px; color: rgb(217, 210, 196); }

#toast .tx { position: absolute; top: 10px; right: 12px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(217, 210, 196); font-size: 14px; cursor: pointer; }

.note { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }

.footnote { margin-top: 26px; font-size: 12px; color: var(--ink-soft); line-height: 1.6; border-top: 1px solid var(--line); padding-top: 14px; }
